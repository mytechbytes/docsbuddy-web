---
import Icon from "./Icon.astro";
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
  class={`grid h-10 w-10 place-items-center rounded-xl border border-line text-ink-2 transition-colors hover:border-ink-2 hover:text-ink ${className}`}
>
  <Icon name="moon" size={19} class="icon-moon" />
  <Icon name="sun" size={19} class="icon-sun" />
</button>
