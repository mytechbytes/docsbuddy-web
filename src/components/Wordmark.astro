---
import site from "../data/site.json";
interface Props {
  href?: string;
  class?: string;
}
const { href = "/", class: className = "" } = Astro.props;
---

<a
  href={href}
  class={`inline-flex items-center gap-2 font-extrabold tracking-[-.01em] ${className}`}
>
  <img
    src="/logo.png"
    alt=""
    width="432"
    height="432"
    class="h-[1.5em] w-auto shrink-0 select-none"
  />
  <span>{site.wordmark.head}<span class="text-muted">{site.wordmark.tail}</span></span>
</a>
