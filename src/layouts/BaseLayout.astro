---
import "../styles/global.css";
import site from "../data/site.json";
import themesData from "../data/themes.json";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  bodyClass?: string;
}
const { title, description = site.description, noindex = false, bodyClass = "" } = Astro.props;

const defaultTheme = themesData.default;

// Build :root (default theme) + html[data-theme="…"] override blocks from themes.json.
const toBlock = (selector: string, vars: Record<string, string>) =>
  `${selector}{${Object.entries(vars)
    .map(([k, v]) => `${k}:${v}`)
    .join(";")}}`;

const themeCss = [
  toBlock(":root", themesData.themes[defaultTheme].vars),
  ...Object.entries(themesData.themes).map(([name, t]) =>
    toBlock(`html[data-theme="${name}"]`, t.vars),
  ),
].join("\n");

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230D1A2B'/%3E%3Ctext x='16' y='22' font-family='sans-serif' font-size='18' font-weight='800' fill='white' text-anchor='middle'%3ED%3C/text%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    {/* Theme variable blocks generated from themes.json. */}
    <style is:global set:html={themeCss}></style>

    {/* Pre-paint: set the stored theme + .js flag before first paint (no flash). */}
    <script is:inline define:vars={{ defaultTheme }}>
      (function () {
        try {
          var t = localStorage.getItem("db-theme");
          document.documentElement.dataset.theme =
            t === "light" || t === "dark" ? t : defaultTheme;
        } catch (e) {
          document.documentElement.dataset.theme = defaultTheme;
        }
        document.documentElement.classList.add("js");
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <slot />

    {/* Bundled + inlined by Astro. Enhancement only — content works without these. */}
    <script>
      import "../scripts/nav.js";
      import "../scripts/reveal.js";
      import "../scripts/theme.js";
    </script>
  </body>
</html>
